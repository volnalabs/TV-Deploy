{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TV Deploy",
  "version": "0.1.0",
  "identifier": "io.github.volnalabs.tvdeploy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "TV Deploy", "width": 1040, "height": 720, "minWidth": 880, "minHeight": 600, "center": true, "dragDropEnabled": true }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../resources/samsung-cli/": "samsung-cli/",
      "../resources/node/": "node/"
    },
    "category": "Utility",
    "shortDescription": "A simple and modern application installer for Samsung Smart TVs.",
    "licenseFile": "../LICENSE"
  }
}
